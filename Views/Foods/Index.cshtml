@model List<FoodItem>
@{
    ViewData["Title"] = "Đồ ăn, thức uống";
}

<div class="page-head">
    <div>
        <h3>Đồ ăn, thức uống</h3>
        <p class="page-sub">Quản lý danh sách sản phẩm và trạng thái bán.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-sm">
                <label for="q" class="visually-hidden">Tìm theo tên sản phẩm</label>
                <input id="q" name="q" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên sản phẩm" />
            </div>
            <div class="col-sm-auto d-flex gap-2">
                <button class="btn btn-primary" type="submit">Tìm kiếm</button>
                <a class="btn btn-outline-primary" asp-action="Index">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">Không tìm thấy sản phẩm nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table bg-white">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var food in Model)
                {
                    var isActive = food.Status == "Active";
                    <tr>
                        <td>@food.FoodName</td>
                        <td>@food.Price.ToString("N0") đ</td>
                        <td>
                            <span class="pill @(isActive ? "ok" : "off")">@(isActive ? "Đang bán" : "Ngừng bán")</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@food.FoodId">Sửa</a>
                                <form asp-action="ToggleStatus" asp-route-id="@food.FoodId" method="post">
                                    <button class="btn btn-sm @(isActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                        @(isActive ? "Ngừng bán" : "Bán lại")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
