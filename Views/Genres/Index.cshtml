@model IEnumerable<CinemaManagement.Controllers.GenreRowVm>
@{
    ViewData["Title"] = "Thể loại";
}

<div class="page-head">
    <div>
        <h3>Thể loại</h3>
        <p class="page-sub">Quản lý danh sách thể loại phim</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm thể loại</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-9">
                <label for="searchString" class="form-label">Tìm theo tên thể loại</label>
                <input id="searchString" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Nhập tên thể loại" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover bg-white mb-0 align-middle">
            <thead>
                <tr>
                    <th>Tên thể loại</th>
                    <th class="text-center">Số phim</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var genre in Model)
                    {
                        <tr>
                            <td>@genre.GenreName</td>
                            <td class="text-center">@genre.MovieCount</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@genre.GenreId" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@genre.GenreId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa thể loại này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">Không tìm thấy thể loại nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
