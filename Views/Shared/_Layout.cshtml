@{
    var ctrl = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    string On(params string[] c) => c.Contains(ctrl) ? "active" : "";
    bool admin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Rạp Phim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@if (User.Identity.IsAuthenticated)
{
    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">R</span>
            <span class="brand-name">Rạp Phim<small>Quản lý rạp chiếu</small></span>
        </a>
        <nav>
            <div class="nav-group">
                <div class="nav-group-title">Bán hàng</div>
                <a class="side-link @On("Home")" asp-controller="Home" asp-action="Index">Tổng quan</a>
                <a class="side-link @On("Sales")" asp-controller="Sales" asp-action="Index">Bán vé</a>
                <a class="side-link" asp-controller="Sales" asp-action="Check">Kiểm tra vé</a>
                <a class="side-link @On("Showtimes")" asp-controller="Showtimes" asp-action="Index">Lịch chiếu</a>
            </div>
            <div class="nav-group">
                <div class="nav-group-title">Danh mục</div>
                <a class="side-link @On("Movies")" asp-controller="Movies" asp-action="Index">Phim</a>
                <a class="side-link @On("Foods")" asp-controller="Foods" asp-action="Index">Đồ ăn, thức uống</a>
                @if (admin)
                {
                    <a class="side-link @On("Genres")" asp-controller="Genres" asp-action="Index">Thể loại</a>
                    <a class="side-link @On("Rooms")" asp-controller="Rooms" asp-action="Index">Phòng chiếu</a>
                }
            </div>
            @if (admin)
            {
                <div class="nav-group">
                    <div class="nav-group-title">Quản trị</div>
                    <a class="side-link @On("Reports")" asp-controller="Reports" asp-action="Index">Doanh thu</a>
                    <a class="side-link @On("Accounts")" asp-controller="Accounts" asp-action="Index">Tài khoản</a>
                </div>
            }
        </nav>
        <form class="side-user" asp-controller="Account" asp-action="Logout" method="post">
            <div class="who">@User.Identity.Name</div>
            <div class="role mb-2">@(admin ? "Quản trị viên" : "Nhân viên")</div>
            <button class="btn btn-sm btn-outline-light w-100">Đăng xuất</button>
        </form>
    </aside>
}
<div class="content">
    @if (User.Identity.IsAuthenticated)
    {
        <div class="topbar-m"><button id="menuBtn" type="button" aria-label="Mở menu">Menu</button><b>Rạp Phim</b></div>
    }
    <div class="content-inner">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @RenderBody()
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
